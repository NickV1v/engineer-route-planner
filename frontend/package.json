  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "1.9.21",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
